#: templates/core/mail/admin_log.txt:1
#, python-format
msgid ""
"Hello,\n"
"\n"
"the following changes have been performed by %(username)s:\n"
"\n"
"Model: %(class)s\n"
"Object: %(object)s\n"
"Changelog: %(message)s\n"
"\n"
"Regards,\n"
"Your SkriptenTool"
