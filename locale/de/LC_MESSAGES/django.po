#: templates/core/mail/admin_log.txt:1
#, python-format
msgid ""
"Hello,\n"
"\n"
"the following changes have been performed by %(username)s:\n"
"\n"
"Model: %(class)s\n"
"Object: %(object)s\n"
"Changelog: %(message)s\n"
"\n"
"Regards,\n"
"Your Skriptentool"
msgstr ""
"Hallo,\n"
"\n"
"es wurden folgende Änderungen von %(username)s vorgenommen:\n"
"\n"
"Objektklasse: %(class)s\n"
"Objekt: %(object)s\n"
"Änderungsmeldung: %(message)s\n"
"\n"
"Liebe Grüße,\n"
"Euer Skriptentool"

#: templates/core/mail/correction.txt:1
#, python-format
msgid ""
"Hello,\n"
"\n"
"at the last count by %(user)s, there has been a deviation of %(amount)s €!\n"
"\n"
"Regards,\n"
"Your Skriptentool"
msgstr ""
"Hallo,\n"
"\n"
"bei der letzten Zählung von %(user)s gab es eine Abweichung von %(amount)s "
"€!\n"
"\n"
"Liebe Grüße,\n"
"Euer Skriptentool"

#: templates/core/mail/high_balance.txt:1
#, python-format
msgid ""
"Hello,\n"
"\n"
"the last sale has been closed with a balance of %(balance)s €!\n"
"\n"
"Regards,\n"
"Your Skriptentool"
msgstr ""
"Hallo,\n"
"\n"
"der letzte Verkauf wurde mit einem Kassenstand von %(balance)s € "
"geschlossen!\n"
"\n"
"Liebe Grüße,\n"
"Euer Skriptentool"

#: templates/core/mail/printing_quota_booked.txt:1
#, python-format
msgid ""
"Hello,\n"
"\n"
"%(vendor)s has booked %(amount)s pages to the account %(number)s.\n"
"\n"
"Regards,\n"
"Your Skriptentool"
msgstr ""
"Hallo,\n"
"\n"
"der Verkäufer %(vendor)s hat %(amount)s Seiten auf den Account %(number)s "
"gebucht.\n"
"\n"
"Liebe Grüße,\n"
"Euer Skriptentool"

